# DATABASE CONFIGURATION

# 1. Application database account
# Credentials used by FastAPI and automated tests to connect to MySQL.
# Both services use the same database user.
# Keep DB_USER unchanged because it must match the MySQL testing database initialization script.
DB_USER=app_user
DB_PASSWORD=choose_a_password


# 2. MySQL connection inside Docker (keep these values unchanged)
# Hostname of the MySQL service in compose.yaml.
# Keep it unchanged.
DB_HOST=db

# Internal MySQL port used by FastAPI and the test service.
# This is the port exposed inside the MySQL container.
# Keep this value at 3306.
DB_PORT=3306


# 3. Application database
# Database used by the FastAPI application during development.
DB_NAME=order_management_db


# 4. MySQL host port
# Port exposed on your computer to connect to MySQL from outside Docker.
# If this port is already in use on your computer, change it.
# For example, 3307 maps your computer's port 3307 to MySQL's port 3306.
DB_HOST_PORT=3307


# 5. MySQL administrator account
# MySQL's built-in administrator is called "root".
# This password is used to initialize and administer MySQL.
# FastAPI does NOT use this account.
MYSQL_ROOT_PASSWORD=choose_an_admin_password


# 6. Testing database
# Separate database used exclusively by automated tests.
# Keep the name unchanged because it must match the MySQL testing database initialization script.
TEST_DB_NAME=test_order_management_db